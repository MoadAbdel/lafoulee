{
  "name": "lafoulee",
  "private": true,
  "description": "La Foulée : e-commerce multi-boutiques de course à pied (projet fil rouge RNCP 38606)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run start:dev -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "wait:servers": "wait-on -t 120000 http://localhost:4000/api/v1/health http://localhost:3000",
    "lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.1",
    "prettier": "^3.4.2",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    },
    "@vercel/cli-config": {
      "zod": "4.6.7"
    },
    "@vercel/queue": {
      "minimatch": "11.0.9"
    }
  }
}
