// Schéma de données de La Foulée (dossier de conception, C8 et C9).
// Tables et colonnes en snake_case côté PostgreSQL, modèles en PascalCase côté code.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Comptes ----------

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  role            Role      @default(CUSTOMER)
  firstName       String?   @map("first_name")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  totpSecretEnc   String?   @map("totp_secret_enc")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz
  anonymizedAt    DateTime? @map("anonymized_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]
  orders        Order[]
  gdprRequests  GdprRequest[]
  auditLogs     AuditLog[]
  apiKeys       ApiKey[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // Tous les jetons issus d'une même connexion partagent une famille :
  // la réutilisation d'un jeton déjà tourné révoque toute la famille.
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_tokens")
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  GDPR_REQUEST
  PASSWORD_RESET
  EMAIL_CHANGE
}

model EmailToken {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String?           @map("user_id") @db.Uuid
  email     String
  purpose   EmailTokenPurpose
  tokenHash String            @unique @map("token_hash")
  expiresAt DateTime          @map("expires_at") @db.Timestamptz
  usedAt    DateTime?         @map("used_at") @db.Timestamptz
  /// Données liées au jeton (ex. type de demande RGPD).
  metadata  Json?
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz
  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("email_tokens")
}

// ---------- Catalogue ----------

model Store {
  id           String  @id @default(uuid()) @db.Uuid
  slug         String  @unique
  name         String
  address      String
  postalCode   String  @map("postal_code")
  city         String
  openingHours String  @map("opening_hours")
  stocks       Stock[]
  pickupOrders Order[]

  @@map("stores")
}

model Category {
  id          String            @id @default(uuid()) @db.Uuid
  slug        String            @unique
  name        String
  description String
  position    Int               @default(0)
  products    ProductCategory[]

  @@map("categories")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id               String                   @id @default(uuid()) @db.Uuid
  slug             String                   @unique
  name             String
  brand            String
  shortDescription String                   @map("short_description")
  description      String
  attributes       Json                     @default("{}")
  priceCents       Int                      @map("price_cents")
  vatRate          Decimal                  @default(20.00) @map("vat_rate") @db.Decimal(4, 2)
  status           ProductStatus            @default(DRAFT)
  // Colonne maintenue par un trigger SQL (migration), utilisée par la recherche.
  searchVector     Unsupported("tsvector")? @map("search_vector")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  categories ProductCategory[]
  variants   ProductVariant[]
  images     ProductImage[]

  @@index([searchVector], type: Gin)
  @@index([status, createdAt])
  @@map("products")
}

model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductVariant {
  id                 String      @id @default(uuid()) @db.Uuid
  productId          String      @map("product_id") @db.Uuid
  sku                String      @unique
  size               String
  color              String
  position           Int         @default(0)
  priceCentsOverride Int?        @map("price_cents_override")
  product            Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  stocks             Stock[]
  orderLines         OrderLine[]

  @@unique([productId, size, color])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  blobUrl   String  @map("blob_url")
  alt       String
  /// Coloris montré par la photo (null : photo commune à tous les coloris).
  color     String?
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// RG1 : CHECK (reserved <= quantity) ajouté en SQL dans la migration.
model Stock {
  variantId      String         @map("variant_id") @db.Uuid
  storeId        String         @map("store_id") @db.Uuid
  quantity       Int
  reserved       Int            @default(0)
  alertThreshold Int            @default(2) @map("alert_threshold")
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  store          Store          @relation(fields: [storeId], references: [id])

  @@id([variantId, storeId])
  @@index([storeId])
  @@map("stocks")
}

// ---------- Commandes et paiements ----------

enum OrderStatus {
  PENDING
  PAID
  READY_FOR_PICKUP
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum Fulfillment {
  PICKUP
  DELIVERY
}

// RG2 : CHECK sur fulfillment / pickup_store_id / shipping_address ajouté en SQL.
model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  number             Int         @unique @default(autoincrement())
  userId             String?     @map("user_id") @db.Uuid
  guestEmail         String?     @map("guest_email")
  status             OrderStatus @default(PENDING)
  fulfillment        Fulfillment
  pickupStoreId      String?     @map("pickup_store_id") @db.Uuid
  shippingAddress    Json?       @map("shipping_address")
  subtotalCents      Int         @map("subtotal_cents")
  shippingCents      Int         @default(0) @map("shipping_cents")
  totalCents         Int         @map("total_cents")
  /// Empreinte du jeton qui permet au client (même sans compte) de suivre sa commande.
  accessTokenHash    String      @map("access_token_hash")
  /// Date d'envoi de l'email de confirmation (envoi idempotent).
  confirmationSentAt DateTime?   @map("confirmation_sent_at") @db.Timestamptz
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  pickupStore Store?      @relation(fields: [pickupStoreId], references: [id])
  lines       OrderLine[]
  payments    Payment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderLine {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  variantId      String         @map("variant_id") @db.Uuid
  storeId        String?        @map("store_id") @db.Uuid
  productName    String         @map("product_name")
  variantLabel   String         @map("variant_label")
  unitPriceCents Int            @map("unit_price_cents")
  quantity       Int
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_lines")
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  orderId               String        @map("order_id") @db.Uuid
  stripePaymentIntentId String        @unique @map("stripe_payment_intent_id")
  status                PaymentStatus @default(REQUIRES_PAYMENT)
  amountCents           Int           @map("amount_cents")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// RG3 : un événement Stripe n'est traité qu'une fois.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@map("stripe_events")
}

// ---------- Newsletter, RGPD, administration ----------

enum SubscriptionStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

model NewsletterSubscription {
  id          String             @id @default(uuid()) @db.Uuid
  email       String             @unique
  status      SubscriptionStatus @default(PENDING)
  tokenHash   String?            @unique @map("token_hash")
  confirmedAt DateTime?          @map("confirmed_at") @db.Timestamptz
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz

  @@map("newsletter_subscriptions")
}

enum GdprRequestType {
  ACCESS
  DELETION
}

enum GdprRequestStatus {
  OPEN
  DONE
}

model GdprRequest {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String?           @map("user_id") @db.Uuid
  email     String
  type      GdprRequestType
  status    GdprRequestStatus @default(OPEN)
  dueAt     DateTime          @map("due_at") @db.Timestamptz
  closedAt  DateTime?         @map("closed_at") @db.Timestamptz
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("gdpr_requests")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  prefix     String    @unique
  keyHash    String    @map("key_hash")
  scopes     String[]
  createdBy  String    @map("created_by") @db.Uuid
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  creator    User      @relation(fields: [createdBy], references: [id])

  @@map("api_keys")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  ip        String?
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("audit_logs")
}

/// Preuve du consentement aux cookies (RGPD, article 7.1) : aucune donnée
/// identifiante, seulement un identifiant aléatoire généré par le navigateur.
/// Conservée 6 mois.
model ConsentLog {
  id        String   @id @default(uuid()) @db.Uuid
  consentId String   @map("consent_id") @db.Uuid
  version   String
  choices   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([consentId])
  @@index([createdAt])
  @@map("consent_logs")
}
